.build/
.swiftpm/
ios/.derived*/
ios/.packages/
# Session working dirs — never commit (may contain personal audio/transcripts).
# A few pre-existing build/ files (test fixtures, early reports) remain tracked.
build/
*.log
*.xcodeproj
# The Mac app's Xcode project is committed; per-user state and settings are not.
!/speakfree.xcodeproj
xcuserdata/
/Xcode/Local.xcconfig
*.app
.DS_Store
.beads
.claude/
*.zip
*.dmg
*.psd
*.png
!ios/Sources/SpeakFreeKeyboardApp/Assets.xcassets/AppIcon.appiconset/AppIcon-1024.png
*.jsonl
*conflicted*
.playwright-mcp/
.vscode/
docs/superpowers/
.gstack/
.agents/
# Shadow-whisper sidecars the test suite writes next to audio fixtures.
Tests/SpeakFreeTests/AudioFixtures/*.whisper.txt
